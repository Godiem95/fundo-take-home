{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand":   { "blue":  { "$value": "#0083ff", "$type": "color", "$description": "Logo, links, accents" },
                 "navy":  { "$value": "#003b8e", "$type": "color", "$description": "Primary button" } },
    "accent":  { "cyan":  { "$value": "#00b9da", "$type": "color", "$description": "Dark backgrounds only; 2.6:1 on white" } },
    "status":  { "success":   { "$value": "#00c753", "$type": "color" },
                 "attention": { "$value": "#ffc600", "$type": "color" },
                 "error":     { "$value": "#d92d20", "$type": "color" },
                 "errorText": { "$value": "#b42318", "$type": "color" } },
    "callout": { "bg": { "$value": "#e8f3ff", "$type": "color" }, "border": { "$value": "#cfe4ff", "$type": "color" } },
    "action":  { "disabled": { "$value": "#8a9bd4", "$type": "color" } },
    "ink":     { "primary":   { "$value": "#0a0a0a", "$type": "color" },
                 "secondary": { "$value": "#334153", "$type": "color" },
                 "tertiary":  { "$value": "#6b7280", "$type": "color" } },
    "line":    { "default":   { "$value": "#e5e7eb", "$type": "color" } },
    "surface": { "page": { "$value": "#f7f8fb", "$type": "color" }, "card": { "$value": "#ffffff", "$type": "color" } }
  },
  "font": {
    "display": { "$value": "Outfit, system-ui, sans-serif", "$type": "fontFamily" },
    "body":    { "$value": "Roboto, system-ui, sans-serif", "$type": "fontFamily" },
    "email":   { "$value": "Arial, Helvetica, sans-serif", "$type": "fontFamily", "$description": "Inbox fallback" }
  },
  "type": {
    "h1":     { "$value": { "fontFamily": "{font.display}", "fontWeight": 700, "fontSize": "24px", "lineHeight": "29px" }, "$type": "typography" },
    "h2":     { "$value": { "fontFamily": "{font.display}", "fontWeight": 700, "fontSize": "24px", "lineHeight": "32px" }, "$type": "typography" },
    "h3":     { "$value": { "fontFamily": "{font.display}", "fontWeight": 700, "fontSize": "18px", "lineHeight": "28px" }, "$type": "typography" },
    "body":   { "$value": { "fontFamily": "{font.body}", "fontWeight": 400, "fontSize": "16px", "lineHeight": "24px" }, "$type": "typography" },
    "label":  { "$value": { "fontFamily": "{font.body}", "fontWeight": 500, "fontSize": "14px", "lineHeight": "16px" }, "$type": "typography" },
    "helper": { "$value": { "fontFamily": "{font.body}", "fontWeight": 400, "fontSize": "13px", "lineHeight": "18px" }, "$type": "typography" },
    "legal":  { "$value": { "fontFamily": "{font.body}", "fontWeight": 400, "fontSize": "12px", "lineHeight": "18px" }, "$type": "typography" }
  },
  "space": { "1": { "$value": "4px", "$type": "dimension" }, "2": { "$value": "8px", "$type": "dimension" },
             "3": { "$value": "12px", "$type": "dimension" }, "4": { "$value": "16px", "$type": "dimension" },
             "5": { "$value": "24px", "$type": "dimension" }, "6": { "$value": "32px", "$type": "dimension" },
             "7": { "$value": "48px", "$type": "dimension" }, "8": { "$value": "64px", "$type": "dimension" } },
  "radius": { "pill": { "$value": "9999px", "$type": "dimension" }, "card": { "$value": "16px", "$type": "dimension" },
              "hero": { "$value": "24px", "$type": "dimension" }, "callout": { "$value": "12px", "$type": "dimension" } },
  "size": { "input": { "$value": "46px", "$type": "dimension" }, "button": { "$value": "50px", "$type": "dimension" }, "touch": { "$value": "44px", "$type": "dimension" } },
  "semantic": {
    "action": { "primary": { "$value": "{color.brand.navy}", "$type": "color" }, "link": { "$value": "{color.brand.blue}", "$type": "color" } },
    "progress": { "fill": { "$value": "{color.status.success}", "$type": "color" }, "track": { "$value": "{color.line.default}", "$type": "color" } },
    "callout": { "attention": { "$value": "{color.status.attention}", "$type": "color" } }
  }
}
